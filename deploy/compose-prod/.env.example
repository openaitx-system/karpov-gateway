# ============================================================================
# Karpov Gateway 生产 .env 模板
# 用法: cp .env.example .env  →  填好下面所有 __CHANGE_ME_*__ 后启动
# ============================================================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 端口 (host 暴露; 改成你机器上空闲的端口) ----
GATEWAY_PORT_EXT=18080
WEB_PORT_EXT=13000
PGADMIN_PORT=15050
POSTGRES_PORT_EXT=15432
REDIS_PORT_EXT=16379

# ---- PostgreSQL ----
# 生成强口令: openssl rand -base64 24
POSTGRES_USER=mgw
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_PG_PASSWORD__
POSTGRES_DB=mgw
# DSN 密码需 url-encode 特殊字符 (% → %25, @ → %40, : → %3A, / → %2F)
MGW_GATEWAY_PG=postgres://mgw:__CHANGE_ME_STRONG_PG_PASSWORD_URLENC__@postgres:5432/mgw?sslmode=disable

# ---- Redis ----
REDIS_PASSWORD=__CHANGE_ME_STRONG_REDIS_PASSWORD__
REDIS_MAXMEMORY=512mb

# ---- pgAdmin ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=__CHANGE_ME_STRONG_PGADMIN_PASSWORD__

# ---- Gateway 业务凭据 ----
# 32 字节 hex KEK (生成: openssl rand -hex 32)
POOL_KEK_HEX=__FILL_KEK_HERE__
ADMIN_TOKEN=__CHANGE_ME_STRONG_ADMIN_TOKEN__
BOOTSTRAP_EMAIL=admin@example.com
REGISTER_IP_LIMIT=false

# ---- SMTP (邮箱验证 / 激活的 hard dependency, 不填会让下面两个 REQUIRED 自动 demote 成 false) ----
# 推荐: QQ 邮箱(smtp.qq.com:465 SSL + 授权码) / 163(smtp.163.com:465 SSL + 授权码) / 自建 Postfix
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=__FILL_SMTP_USER_HERE__
SMTP_PASSWORD=__FILL_SMTP_AUTH_CODE_HERE__
SMTP_FROM=__FILL_SMTP_FROM_HERE__
SMTP_FROM_NAME=Karpov
# TLS 模式: auto (按端口推断 465=ssl, 587=starttls) / starttls / ssl / none
SMTP_TLS=ssl

# ---- OAuth2 第三方登录 (Linux.do SSO) ----
# Linux.do connect 申请页: https://connect.linux.do
# 回调地址 (填到 linux.do 申请表单): https://your-domain.example.com/v1/auth/oauth/linuxdo/callback
OAUTH_PUBLIC_BASE=https://your-domain.example.com
OAUTH_FRONTEND_BASE=https://your-domain.example.com
OAUTH_LINUXDO_ENABLED=false
OAUTH_LINUXDO_CLIENT_ID=__FILL_LINUXDO_CLIENT_ID__
OAUTH_LINUXDO_CLIENT_SECRET=__FILL_LINUXDO_CLIENT_SECRET__
OAUTH_LINUXDO_MIN_TRUST_LEVEL=1
OAUTH_LINUXDO_REQUIRE_ACTIVE=true

# ---- 邮箱验证 + 激活 ----
# - EMAIL_VERIFY_REQUIRED=true: 注册时必须先发验证码并填对, 后端拒绝空 verification_code
# - ACTIVATION_REQUIRED=true: 注册成功后账号 status=pending_email, 用户必须点邮件激活链接才能登录
# 注意: 上面 SMTP_HOST / SMTP_FROM 任一为空, 启动时会被自动 demote 成 false (LogSender 兜底, 仅 dev 用)
EMAIL_VERIFY_REQUIRED=true
ACTIVATION_REQUIRED=true
ACTIVATION_BASE_URL=https://your-domain.example.com/activate

# ---- Web ----
# 生产 HTTPS 域名 (反向代理 https://your-domain.example.com → host:13000)
# 注意: 改 NEXT_PUBLIC_APP_URL 必须 docker compose build --no-cache web,
# 因为该值会在 build time inline 进 client bundle.
NEXT_PUBLIC_APP_URL=https://your-domain.example.com
NEXT_PUBLIC_APP_NAME=Karpov Console
BACKEND_URL=http://gateway:8080
SESSION_COOKIE_NAME=sid
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# 反代后必须为 true 让 web/gateway 信任 X-Forwarded-Proto 等头
TRUST_PROXY=true
PROXY_TIMEOUT_MS=20000
