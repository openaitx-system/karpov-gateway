# ================================================================
# docker-compose 环境变量样例（开发依赖编排）
# 使用：cp .env.example .env  并修改密码
# ================================================================

# ---- PostgreSQL ----
POSTGRES_USER=mgw
# 密码强度自行保证；以下仅示例，请改为高熵串
POSTGRES_PASSWORD=ChangeThisStrongPostgresPwd!
POSTGRES_DB=mgw
POSTGRES_PORT=5432

# ---- pgAdmin 4（PostgreSQL 可视化管理）----
# pgAdmin 自身的 web 登录账号
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=ChangeThisStrongPgAdminPwd!
PGADMIN_PORT=5050

# ---- Redis ----
REDIS_PASSWORD=ChangeThisStrongRedisPwd!
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
